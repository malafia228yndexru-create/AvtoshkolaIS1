<Window x:Class="_1._7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_1._7"
        mc:Ignorable="d"
       Title="MainWindow" Height="450" Width="800" Style="{StaticResource WindowStyle}">
    <Grid Margin="15">
        <Image Style="{StaticResource logoImageStyle}"/>

        <Button Content="Войти в систему" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <DataGrid HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="400" Height="150" Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Width="*"/>
                <DataGridTextColumn Header="Группа" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
